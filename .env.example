# ==============================================================================
# MindVault - Environment Configuration Template
# ==============================================================================
# IMPORTANT: DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy this file to .env.local for local development.
# In Cloud Run production, secrets are managed securely via Google Secret Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public/Client-Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourClientApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ------------------------------------------------------------------------------
# 2. Server-Side Google Cloud / Firebase Admin Configuration
# ------------------------------------------------------------------------------
# In Cloud Run: Project ID and Service Account authentication use Application Default Credentials (ADC).
# Locally: Provide project ID or service account path if needed.
GCP_PROJECT_ID="your-project-id"
FIREBASE_PROJECT_ID="your-project-id"

# ------------------------------------------------------------------------------
# 3. Google Gemini API Configuration (Server-Side ONLY)
# ------------------------------------------------------------------------------
# Local development fallback when not running in Cloud Run Secret Manager:
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 4. Optional: Google Maps / Places API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-javascript-client-key-placeholder"
GOOGLE_PLACES_API_KEY="your-places-server-key-placeholder"

# ------------------------------------------------------------------------------
# 5. Secret Manager Secret Names (In Google Cloud Secret Manager)
# ------------------------------------------------------------------------------
SECRET_NAME_GEMINI_API_KEY="MINDVAULT_GEMINI_API_KEY"
SECRET_NAME_PLACES_API_KEY="MINDVAULT_PLACES_API_KEY"
